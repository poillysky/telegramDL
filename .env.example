# 从 https://my.telegram.org 获取
API_ID=12345678
API_HASH=your_api_hash_here

# Web 管理页账号密码（密码留空则不启用登录保护）
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# 可选代理（留空=直连；国内不稳时可开）
# Clash 混合口常见: socks5://127.0.0.1:7897  或 socks5://127.0.0.1:7891
# 也可: http://127.0.0.1:7890
PROXY=

HOST=0.0.0.0
PORT=9345

# 本地开发用相对路径；Docker 部署时由 docker-compose 覆盖为 /app/...
DOWNLOAD_DIR=downloads
# 未完成下载先落这里，完成后再移入 DOWNLOAD_DIR
TEMP_DIR=temp
DATA_DIR=data
SESSION_DIR=sessions
SESSION_NAME=telegram_downloader

MAX_PARALLEL_CHATS=1
# 单文件下载间隔（秒）；也可设区间随机：DOWNLOAD_DELAY_MIN / DOWNLOAD_DELAY_MAX
DOWNLOAD_DELAY=0.5
DOWNLOAD_DELAY_MIN=0.5
DOWNLOAD_DELAY_MAX=0.5
MAX_RETRIES=3
MIN_FOLDER_TITLE_LEN=2
# FloodWait 自动等待上限（秒），超过则暂停任务
MAX_FLOOD_WAIT=1800

# 单文件下载吞吐（代理环境下尤其重要；也可在 Web「设置 → 运行」里改，优先生效）
# MEDIA_CONNECTIONS: 媒体 DC 并行 TCP 数（硬上限 8）
# DOWNLOAD_PIPELINE: 单文件同时在途的分块数（硬上限 8）
# DOWNLOAD_PART_SIZE: 每块字节数，官方最大 1048576（1MiB）；拒绝时自动回退 512KiB
# 安全范围：连接 2–3 / 流水线 3–4（下方为安全默认）
# 加速可试 5/6；出现 FloodWait 立刻降回 3/4
MEDIA_CONNECTIONS=3
DOWNLOAD_PIPELINE=4
DOWNLOAD_PART_SIZE=1048576

# 测试模式：不下载完整媒体，只按文案建目录/占位文件；约 N 秒后自动停
# 也可在 Web 创建任务时勾选「测试模式」
TEST_MODE=false
TEST_DURATION_SEC=10
